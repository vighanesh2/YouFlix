# Get your key at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here
PORT=3001

# MongoDB (local default or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/youflix

# Redis for BullMQ job queue
REDIS_URL=redis://localhost:6379

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Hours before re-importing an existing playlist
SYNC_COOLDOWN_HOURS=24

# Auth — set a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Vercel Blob — required for cover uploads in production (backend service)
# 1. Vercel project → Storage → Create Blob store
# 2. Connect it to the **backend** service (not just frontend)
# 3. Redeploy — Vercel sets BLOB_READ_WRITE_TOKEN automatically
# For local dev with Blob: copy the token from Vercel into backend/.env
BLOB_READ_WRITE_TOKEN=
# Optional: set to "private" if your Blob store is private (auto-detected on upload if omitted)
# BLOB_ACCESS=private
